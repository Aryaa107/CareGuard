# ---------------------------------------------------------------
# CareGuard — environment configuration
# Copy to `.env` and fill in. `.env` is gitignored; never commit it.
#   cp .env.example .env
# ---------------------------------------------------------------

# --- MongoDB --------------------------------------------------
# Atlas: Dashboard > Connect > Drivers > Node.js
# Must match `careguard` exactly in the connection string.
MONGODB_URI=mongodb+srv://200ptkm_db_user:bahx8MJAK6YDBuAk@careguard.beerv3w.mongodb.net

# Print redacted connection info on boot. Never prints credentials.
MONGODB_LOG_TURNS=1

# --- Server ---------------------------------------------------
PORT=4000
NODE_ENV=development

# Sent as `Access-Control-Allow-Origin`. In dev the Vite proxy handles
# CORS, so this only matters if you serve the built SPA from elsewhere.
CORS_ORIGIN=http://localhost:5173

# --- Sessions -------------------------------------------------
# Session lifetime in hours. Matched by the TTL index on
# `sessions.expiresAt`, which MongoDB reapplies on its own schedule.
SESSION_TTL_HOURS=12

# --- Client (Vite) --------------------------------------------
# Only needed if you run the API on a different origin than the proxy.
# Leave empty to use the dev proxy on /api.
VITE_API_BASE=
